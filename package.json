{
  "name": "dsh-mobile-atlas",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Adds left-edge swipe navigation to mobile Web and top clearance to the iOS Home Screen app.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-bundle",
    "mobile",
    "aggregate"
  ],
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "aggregate.yml",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "AGENTS.md",
    "AGENTS.local.md",
    "docs/README.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3"
  },
  "scripts": {
    "aggregate": "node ../../tools/dsh-aggregate/cli.mjs generate .",
    "check": "node ../../tools/dsh-aggregate/cli.mjs check .",
    "prepack": "node ../../tools/dsh-aggregate/cli.mjs check ."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "aggregate": {
      "plugins": [
        "dsh-swipe-back",
        "dsh-ios-top-clearance"
      ]
    }
  },
  "dependencies": {
    "dsh-swipe-back": "link:../dsh-swipe-back",
    "dsh-ios-top-clearance": "link:../dsh-ios-top-clearance"
  }
}
